{
  "expo": {
    "name": "Ẽm",
    "slug": "em-cycle-health",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "em",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.em.cyclehealth",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Ẽm uses Face ID to protect your private health data."
      },
      "icon": {
        "light": "./assets/icon/icon-ios.png",
        "dark": "./assets/icon/icon-ios-dark.png",
        "tinted": "./assets/icon/icon-ios-tinted.png"
      }
    },
    "android": {
      "package": "com.em.cyclehealth",
      "permissions": [
        "POST_NOTIFICATIONS"
      ],
      "icon": "./assets/icon/icon-android.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon/adaptive-icon.png",
        "backgroundColor": "#FBF6EF"
      }
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      "expo-secure-store",
      "expo-local-authentication",
      [
        "expo-notifications",
        {
          "color": "#7E3F46"
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash/splash-mark.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#FBF6EF",
          "dark": {
            "image": "./assets/splash/splash-mark-dark.png",
            "backgroundColor": "#141010"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
