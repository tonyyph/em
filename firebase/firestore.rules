rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsUserScopedDoc() {
      return signedIn() && request.resource.data.userId == request.auth.uid;
    }

    function ownsExistingDoc() {
      return signedIn() && resource.data.userId == request.auth.uid;
    }

    match /users/{userId} {
      allow read, write, delete: if signedIn() && request.auth.uid == userId;
    }

    match /cycles/{docId} {
      allow create, update: if ownsUserScopedDoc();
      allow read, delete: if ownsExistingDoc();
    }

    match /symptoms/{docId} {
      allow create, update: if ownsUserScopedDoc();
      allow read, delete: if ownsExistingDoc();
    }

    match /ovulation_logs/{docId} {
      allow create, update: if ownsUserScopedDoc();
      allow read, delete: if ownsExistingDoc();
    }

    match /pregnancy/{docId} {
      allow create, update: if ownsUserScopedDoc();
      allow read, delete: if ownsExistingDoc();
    }

    match /subscriptions/{docId} {
      allow read: if ownsExistingDoc();
      allow write: if false;
    }
  }
}
