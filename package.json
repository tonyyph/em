{
  "name": "em-cycle-health",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start -c",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand --watchman=false",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint && npx tsc --noEmit",
    "all": "watchman watch-del-all && rm -rf yarn.lock && rm -rf node_modules/",
    "setup": "npx expo install",
    "prebuild": "npx expo prebuild --no-install",
    "assets:build": "tsc -p scripts/tsconfig.build.json && node .assets-build/scripts/build-brand-assets.js"
  },
  "dependencies": {
    "@expo-google-fonts/be-vietnam-pro": "^0.4.1",
    "@expo-google-fonts/fraunces": "^0.4.1",
    "@expo/vector-icons": "^15.1.1",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@tanstack/react-query": "^5.83.0",
    "dayjs": "^1.11.13",
    "expo": "~57.0.1",
    "expo-auth-session": "^57.0.6",
    "expo-blur": "~57.0.2",
    "expo-crypto": "^57.0.1",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-linear-gradient": "~57.0.1",
    "expo-local-authentication": "^57.0.2",
    "expo-localization": "^57.0.1",
    "expo-notifications": "^57.0.9",
    "expo-router": "^57.0.11",
    "expo-secure-store": "^57.0.1",
    "expo-splash-screen": "~57.0.6",
    "expo-status-bar": "^57.0.1",
    "firebase": "^12.0.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/react-native": "^13.3.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^26.2.0",
    "@types/react": "~19.2.0",
    "babel-jest": "^29.7.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.1",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.4",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
